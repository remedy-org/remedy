# Copy to .env and fill in. Never commit .env.

# PayPal sandbox REST app. Create it under the US sandbox BUSINESS account (see docs/EVAL.md).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# A US sandbox PERSONAL account's email; it receives the test payout.
PAYPAL_RECEIVER_EMAIL=

# Must match the Return URL saved in the app's "Log in with PayPal" settings.
# Use 127.0.0.1, not localhost: the dashboard fails to save a localhost URL.
PAYPAL_REDIRECT_URI=http://127.0.0.1:8787/callback

# Vision checks and recall-spec drafting (GPT-6.1 Sol by default).
OPENAI_API_KEY=

# Optional: not used by the app or the eval yet.
ANTHROPIC_API_KEY=

# Public base URL of the app (login return, webhooks, claim links).
APP_URL=http://127.0.0.1:3000
