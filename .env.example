# Copy to .env and fill in. Never commit .env.

# PayPal sandbox REST app. Create it under the US sandbox BUSINESS account (see docs/EVAL.md).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: the ID of the app's webhook at APP_URL/api/webhooks/paypal (PAYMENT.PAYOUTS-ITEM.* events).
# Unset, the webhook route refuses every event; the console still re-checks unsettled payouts on load.
PAYPAL_WEBHOOK_ID=

# A US sandbox PERSONAL account's email; it receives the test payout.
PAYPAL_RECEIVER_EMAIL=

# Must match the Return URL saved in the app's "Log in with PayPal" settings.
# Use 127.0.0.1, not localhost: the dashboard fails to save a localhost URL.
PAYPAL_REDIRECT_URI=http://127.0.0.1:8787/callback

# Vision checks and recall-spec drafting (GPT-6.1 Sol by default).
OPENAI_API_KEY=

# Optional: not used by the app or the eval yet.
ANTHROPIC_API_KEY=

# Public base URL of the app (login return, webhooks, claim links).
# Log in with PayPal returns to APP_URL/api/auth/paypal/callback: add that Return URL in the PayPal dashboard.
APP_URL=http://127.0.0.1:3000

# Signs the session cookies. At least 32 characters; generate with: openssl rand -base64 32
# Leave empty in local dev to use the built-in dev secret. Required in production.
SESSION_SECRET=

# PayPal sandbox test logins for running the demo end to end (US accounts from developer.paypal.com)
SANDBOX_PERSONAL_EMAIL=
SANDBOX_PERSONAL_PASSWORD=
SANDBOX_BUSINESS_EMAIL=
SANDBOX_BUSINESS_PASSWORD=
