# Copy to .env and fill in. Never commit .env.

# PayPal sandbox REST app. Create it under the US sandbox BUSINESS account (see docs/EVAL.md).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: the ID of the app's webhook at APP_URL/api/webhooks/paypal (PAYMENT.PAYOUTS-ITEM.* events).
# Unset, the webhook route refuses every event; the console still re-checks unsettled payouts on load.
PAYPAL_WEBHOOK_ID=

# A US sandbox PERSONAL account's email; it receives the test payout.
PAYPAL_RECEIVER_EMAIL=

# Must match the Return URL saved in the app's "Log in with PayPal" settings.
# Use 127.0.0.1, not localhost: the dashboard fails to save a localhost URL.
PAYPAL_REDIRECT_URI=http://127.0.0.1:8787/callback

# Vision checks and recall-spec drafting (GPT-6.1 Sol by default).
OPENAI_API_KEY=

# Optional: not used by the app or the eval yet.
ANTHROPIC_API_KEY=

# Public base URL of the app (login return, webhooks, claim links).
# Log in with PayPal returns to APP_URL/api/auth/paypal/callback: add that Return URL in the PayPal dashboard.
APP_URL=http://127.0.0.1:3000

# Signs the session cookies. At least 32 characters; generate with: openssl rand -base64 32
# Leave empty in local dev to use the built-in dev secret. Required in production.
SESSION_SECRET=

# Optional: what the live demo may spend. Days are UTC; empty means the default shown. Model calls are counted in
# the store (usage/<day>.json); claims are counted from the claim index. A real claim costs about 10 Vercel Blob
# writes and a demo round of four about 24, and the Hobby plan allows 2,000 a month, hence the 30-day limits.
# Photo checks a day (about $0.011 each). Past it a real claim is held for a person; demo claims can't start.
VISION_DAILY_LIMIT=100
# Recall-check drafts a day in the console. Past it the company writes the checks itself.
DRAFT_DAILY_LIMIT=20
# New real claims a day and in any 30 days. Demo claims never count towards these.
CLAIM_DAILY_LIMIT=10
CLAIM_MONTHLY_LIMIT=30
# Real claims one PayPal account can start a day (abandoned ones count), and demo claims it can run.
ACCOUNT_CLAIM_DAILY_LIMIT=5
ACCOUNT_DEMO_DAILY_LIMIT=40
# Demo claims every account together, a day and in any 30 days (abandoned starts count).
DEMO_DAILY_LIMIT=40
DEMO_MONTHLY_LIMIT=200

# PayPal sandbox test logins for running the demo end to end (US accounts from developer.paypal.com).
# In a sandbox build, judges see the personal one on /r/<slug>/try and on /signin. Unset hides it. The business
# one owns the PayPal app and can't sign in to it.
SANDBOX_PERSONAL_EMAIL=
SANDBOX_PERSONAL_PASSWORD=
SANDBOX_BUSINESS_EMAIL=
SANDBOX_BUSINESS_PASSWORD=

# Optional: AG Studio licence key for the Insights page
NEXT_PUBLIC_AG_STUDIO_LICENSE=
# Optional: the Recall analyst model (default gpt-5.4-mini)
ANALYST_MODEL=
